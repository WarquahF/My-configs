// Liquid Glass Waybar — Sway variant (1920x1080 @ 1.5x scale)
// Same islands as Hyprland; left modules are sway/workspaces + sway/mode.
// Launched by sway/config bar block with `-c config-sway.jsonc`.
// Font: MesloLGS Nerd Font Mono. See ../README.md + ../sway/README.md.
{
    "layer": "top",
    "position": "top",
    // Compact height suits 1080p @ 1.5 scale; margins keep the bar floating.
    "height": 38,
    "spacing": 8,
    "margin-top": 10,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left": [
        "sway/workspaces",
        "sway/mode"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "network",
        "bluetooth",
        "pulseaudio",
        "battery",
        "temperature",
        "memory",
        "custom/awake",
        "custom/notifications",
        "custom/screenshot",
        "custom/screenrecord",
        "custom/power"
    ],

    // Left: Sway workspaces 1-5 + mode indicator. Click to jump.
    "sway/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": 5
        }
    },
    "sway/mode": {
        "format": "{}"
    },

    // Center: minimal live clock. Tooltip carries the full date.
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%A, %d %B %Y\n%H:%M}",
        "interval": 30
    },

    // Right: network. Icon-only to stay compact; details live in the tooltip.
    "network": {
        "interval": 10,
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr} via {ifname}",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}",
        "tooltip-format-linked": "{ifname}: no address",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "$HOME/.config/waybar/scripts/wifi-menu.sh"
    },

    // Right: Bluetooth. Icon-only; details in the tooltip.
    // Click opens the rofi menu (power, scan & pair, connect/disconnect).
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-connected": "󰂱 {num_connections}",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "$HOME/.config/waybar/scripts/bluetooth-menu.sh"
    },

    // Right: audio. Scroll to change volume, left-click opens mixer,
    // right-click toggles mute.
    "pulseaudio": {
        "scroll-step": 5,
        "max-volume": 100,
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "tooltip-format": "{desc}\nVolume: {volume}%",
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    // Right: battery. Icons track capacity; charging/plugged/low are distinct.
    "battery": {
        "interval": 30,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-full": "󰁹 {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂"
        ],
        "tooltip-format": "{capacity}% ({time} remaining)\n{power} W",
        "on-click": "$HOME/.config/waybar/scripts/battery-info.sh"
    },

    // Right: CPU temperature (coretemp Package id 0 — the real CPU package
    // sensor). Detected on this machine as:
    //   sensors coretemp-isa-0000 Package id 0 (+53°C)
    //   /sys/class/hwmon/hwmon3 (name=coretemp, device=platform/coretemp.0)
    //   /temp1_input = Package. temp2/3 = Core 0/1.
    // Alternatives rejected: SEN1-5 (board, 0-51°C noise), nvme Composite
    // (SSD, 34°C), INT3400 (chipset, 20°C). x86_pkg_temp thermal_zone7
    // mirrors the same package (53°C) and remains as kernel fallback.
    // temp-info.sh resolves by driver name (coretemp → x86_pkg_temp →
    // TCPU), never by hardcoded number, so zone/hwmon renumbering is safe.
    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon3/temp1_input",
        "critical-threshold": 85,
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "CPU package: {temperatureC}°C",
        "on-click": "kitty --class waybar-dropdown --title 'CPU Temp' -e $HOME/.config/waybar/scripts/temp-info.sh --popup"
    },

    // Right: RAM load. Click opens btop's full view.
    "memory": {
        "interval": 5,
        "format": "󰍛 {percentage}%",
        "tooltip-format": "RAM {used:0.1f} / {total:0.1f} GiB ({percentage}%)\nSwap {swapPercentage}%",
        "on-click": "kitty --class waybar-dropdown --title 'Memory' -e $HOME/.config/waybar/scripts/mem-info.sh --popup"
    },

    // Right: keep-awake toggle. Click flips a logind inhibitor
    // (idle + sleep) via awake.sh — no extra packages. State refreshes
    // every few seconds so it can never show stale info.
    "custom/awake": {
        "exec": "$HOME/.config/waybar/scripts/awake.sh status",
        "return-type": "json",
        "interval": 5,
        "on-click": "$HOME/.config/waybar/scripts/awake.sh toggle"
    },

    // Right: notification bell. Count of visible notifications, history
    // in the tooltip. Click opens the rofi notification center.
    "custom/notifications": {
        "exec": "$HOME/.config/waybar/scripts/notif-status.sh",
        "return-type": "json",
        "interval": 5,
        "on-click": "$HOME/.config/waybar/scripts/notif-center.sh"
    },

    // Right: screenshot button. Opens rofi menu (fullscreen/region/window).
    "custom/screenshot": {
        "format": "󰹑",
        "tooltip-format": "Screenshot menu",
        "on-click": "$HOME/.config/waybar/scripts/screenshot-menu.sh"
    },

    // Right: screen recorder. Red dot while recording; click opens
    // rofi menu (fullscreen / region / stop). State refreshes every 2s.
    "custom/screenrecord": {
        "exec": "$HOME/.config/waybar/scripts/screenrecord-menu.sh status",
        "return-type": "json",
        "interval": 2,
        "on-click": "$HOME/.config/waybar/scripts/screenrecord-menu.sh"
    },

    // Right: power button. wlogout overlay (replaces Noctalia session).
    // Falls back to rofi power-menu.sh if wlogout is missing.
    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Power menu (wlogout)",
        "on-click": "sh -c 'command -v wlogout >/dev/null && wlogout -b 4 -T 400 -B 400 || $HOME/.config/waybar/scripts/power-menu.sh'"
    }
}
